===== Metal =====
vectorised: true
inputs:     [f32[64]]
outputs:    [f32[64]]
args:       [(0, true), (0, false)]
zeroed:     {}
launch:     grid 1x1x1, block 256, smem 0

#include <metal_stdlib>
using namespace metal;

kernel void scalar_constant(device float* n2 [[buffer(0)]], device float* n4 [[buffer(1)]], uint metal_tid [[thread_position_in_grid]]) {
    const int n0 = static_cast<int>(metal_tid);
    if (n0 >= (16)) return;
    const float4 n6 = float4(2.5E0, 2.5E0, 2.5E0, 2.5E0);
    const float4 n8 = reinterpret_cast<device float4*>(n2)[n0];
    float4 n10;n10.x = n8.x + n6.x;n10.y = n8.y + n6.y;n10.z = n8.z + n6.z;n10.w = n8.w + n6.w;
    reinterpret_cast<device float4*>(n4)[n0] = n10;
}

