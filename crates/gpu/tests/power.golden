===== CudaHip =====
vectorised: true
inputs:     [f32[64]]
outputs:    [f32[64]]
args:       [(0, true), (0, false)]
zeroed:     {}
launch:     grid 1x1x1, block 256, smem 0

extern "C" __global__ void power(float* n2, float* n4) {
    const int idx_in_grid = blockIdx.x + blockIdx.y * gridDim.x + blockIdx.z * gridDim.x * gridDim.y;
    const int n0 = idx_in_grid * blockDim.x + threadIdx.x;
    if (n0 >= (16)) return;
    const float4 n6 = reinterpret_cast<float4*>(n2)[n0];
    float4 n8;
    n8.x = expf(n6.x);
    n8.y = expf(n6.y);
    n8.z = expf(n6.z);
    n8.w = expf(n6.w);
    float4 n12;n12.x = powf(n8.x, n6.x);n12.y = powf(n8.y, n6.y);n12.z = powf(n8.z, n6.z);n12.w = powf(n8.w, n6.w);
    reinterpret_cast<float4*>(n4)[n0] = n12;
}

===== Msl =====
vectorised: true
inputs:     [f32[64]]
outputs:    [f32[64]]
args:       [(0, true), (0, false)]
zeroed:     {}
launch:     grid 1x1x1, block 256, smem 0

#include <metal_stdlib>
using namespace metal;

kernel void power(device float* n2 [[buffer(0)]], device float* n4 [[buffer(1)]], uint metal_tid [[thread_position_in_grid]]) {
    const int n0 = static_cast<int>(metal_tid);
    if (n0 >= (16)) return;
    const float4 n6 = reinterpret_cast<device float4*>(n2)[n0];
    float4 n8;
    n8.x = exp(n6.x);
    n8.y = exp(n6.y);
    n8.z = exp(n6.z);
    n8.w = exp(n6.w);
    float4 n12;n12.x = pow(n8.x, n6.x);n12.y = pow(n8.y, n6.y);n12.z = pow(n8.z, n6.z);n12.w = pow(n8.w, n6.w);
    reinterpret_cast<device float4*>(n4)[n0] = n12;
}

