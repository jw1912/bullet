===== Metal =====
vectorised: false
inputs:     [f32[128], i32[8]]
outputs:    [f32[256]]
args:       [(0, true), (1, true), (0, false)]
zeroed:     {0}
launch:     grid 1x1x1, block 256, smem 0

#include <metal_stdlib>
using namespace metal;

kernel void sparse_matmul_bwd(device float* n2 [[buffer(0)]], device int* n4 [[buffer(1)]], device float* n6 [[buffer(2)]], uint metal_tid [[thread_position_in_grid]]) {
    const int n0 = static_cast<int>(metal_tid);
    if (n0 >= (128)) return;
    const float n8 = n2[n0];
    if (n8 != 0) {
                            int uniq_10_1 = n0 / 32;
                            int uniq_10_2 = 0 + n0 % 32;
    
                            for (int i = 0; i < 2; i++) {
                                const int j = n4[2 * uniq_10_1 + i];
                                if (j < 0 || j >= 8) break;
                                atomic_fetch_add_explicit((volatile device atomic_float*)(n6 + j * 32 + uniq_10_2), n8, memory_order_relaxed);
                            }
                        }
}

