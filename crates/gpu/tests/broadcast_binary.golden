extern "C" __global__ void broadcast_binary(float* n2, float* n4, float* n6, float* n8, float* n10) {
    const int idx_in_grid = blockIdx.x + blockIdx.y * gridDim.x + blockIdx.z * gridDim.x * gridDim.y;
    const int n0 = idx_in_grid * blockDim.x + threadIdx.x;
    if (n0 >= (8)) return;
    const float4 n12 = reinterpret_cast<float4*>(n6)[n0];
    reinterpret_cast<float4*>(n8)[n0] = n12;
    const int n15 = 8;
    const int n17 = n0 / n15;
    const int n19 = 2;
    const int n21 = n0 % n19;
    const int n25 = n19 * n17;
    const int n27 = n25 + n21;
    const float4 n29 = reinterpret_cast<float4*>(n2)[n27];
    float4 n33;n33.x = n29.x * n12.x;n33.y = n29.y * n12.y;n33.z = n29.z * n12.z;n33.w = n29.w * n12.w;
    const int n35 = 1;
    const int n37 = n0 / n35;
    const float n39 = n4[n37];
    const float4 n41 = make_float4(n39, n39, n39, n39);
    float4 n43;n43.x = n33.x + n41.x;n43.y = n33.y + n41.y;n43.z = n33.z + n41.z;n43.w = n33.w + n41.w;
    reinterpret_cast<float4*>(n10)[n0] = n43;
}

