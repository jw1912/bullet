    const float4 n16 = reinterpret_cast<device float4*>(n4)[n0];
    float4 n18;n18.x = n14.x + n16.x;n18.y = n14.y + n16.y;n18.z = n14.z + n16.z;n18.w = n14.w + n16.w;
