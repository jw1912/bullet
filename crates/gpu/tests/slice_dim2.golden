===== Metal =====
vectorised: false
inputs:     [f32[8]]
outputs:    [f32[4]]
args:       [(0, true), (0, false)]
zeroed:     {}
launch:     grid 1x1x1, block 256, smem 0

#include <metal_stdlib>
using namespace metal;

kernel void slice_dim2(device float* n2 [[buffer(0)]], device float* n4 [[buffer(1)]], uint metal_tid [[thread_position_in_grid]]) {
    const int n0 = static_cast<int>(metal_tid);
    if (n0 >= (4)) return;
    const int n6 = 1;
    const int n8 = n0 / n6;
    const int n12 = n0 % n6;
    const int n16 = n12 / n6;
    const int n20 = n12 % n6;
    const int n22 = 2;
    const int n24 = n22 * n8;
    const int n26 = 0;
    const int n28 = n24 + n26;
    const int n30 = n28 + n16;
    const int n34 = n30 * n6;
    const int n36 = n34 + n20;
    const float n38 = n2[n36];
    n4[n0] = n38;
}

