===== CUDA =====
vectorised: false
inputs:     [f32[16], i32[4]]
outputs:    [f32[48]]
args:       [(0, true), (1, true), (0, false)]
zeroed:     {}
launch:     grid 1x1x1, block 256, smem 0

extern "C" __global__ void select_pad(float* n2, int* n4, float* n6) {
    const int idx_in_grid = blockIdx.x + blockIdx.y * gridDim.x + blockIdx.z * gridDim.x * gridDim.y;
    const int n0 = idx_in_grid * blockDim.x + threadIdx.x;
    if (n0 >= (48)) return;
    const int n8 = 12;
    const int n10 = n0 / n8;
    const int n14 = n0 % n8;
    const int n16 = 4;
    const int n18 = n14 / n16;
    const int n22 = n14 % n16;
    const int n24 = n4[n10];
    const int n26 = -1;
    const int n28 = n26 * n24;
    const int n30 = n18 + n28;
    const int n32 = n30 == static_cast<int>(0);
    const int n36 = n10 * n16;
    const int n38 = n36 + n22;
    const float n40 = n32 > 0 ? n2[n38] : 0E0;
    n6[n0] = n40;
}

